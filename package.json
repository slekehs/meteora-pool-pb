{
  "name": "meteora-pool-pb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ui": "pnpm --parallel --filter @meteora-pool-pb/web --filter @meteora-pool-pb/server dev",
    "restart:api": "lsof -ti :8787 | xargs kill -9 2>/dev/null; pnpm --filter @meteora-pool-pb/server start",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --import tsx src/runner.ts",
    "plan": "node --import tsx src/runner.ts",
    "simulate": "node --import tsx src/runner.ts --simulate",
    "send": "node --import tsx src/runner.ts --send",
    "devnet:fixture": "node --import tsx src/devnet/create-fixture.ts"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@meteora-pool-pb/shared": "workspace:*",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
