# --- Solana JSON-RPC (required for reads, simulate, send) ---
# Option A (recommended): full URL — Helius API key goes IN the URL query string
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=787598fc-a718-47f7-9d4b-fa7766f4418d

# Option B: key only — app builds the Helius HTTP RPC URL from SOLANA_CLUSTER
# HELIUS_API_KEY=

SOLANA_CLUSTER=devnet

# Path to config (see config/example.yaml) — CLI worker only
APP_CONFIG=./config/example.yaml

# Devnet payer for simulate/send (API + CLI) — pick one, never commit real secrets
PAYER_KEYPAIR_PATH=~/testing-wallets/devnet-testing.json
# PAYER_KEYPAIR_SECRET=   # gitignored .env only — base58 or JSON [1,2,…]
